{
  "name": "@ct/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only dashboard (Vite, React, hash routing). One DashboardApi, two implementations: browser mock and the local HTTP API.",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api-dev",
    "build": "vite build --mode api",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages --port 4320 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@ct/core": "0.0.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2"
  }
}
