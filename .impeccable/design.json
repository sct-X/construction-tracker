  "narrative": {
    "northStar": "The surveyor's night readout",
    "overview": "A graphite instrument face on which the forecast finish and the slip are the readout digits and everything else is the quiet engraving around them. Surfaces separate by tone, hierarchy by size and a three-step brightness ladder. Hi-vis orange appears only where a thumb lands.",
    "keyCharacteristics": [
      "Numbers are the largest type on partner screens",
      "Tonal surfaces, never #000, never a white box",
      "Words carry every status; colour only agrees",
      "Barlow Semi Condensed for figures, Atkinson Hyperlegible Next for words, self-hosted",
      "One accent with a short job list; 56px targets for gloves"
    ],
    "rules": [
      {
        "name": "The Thumb Rule",
        "body": "Orange goes where a thumb lands and nowhere else: one primary action per screen, the focus ring, the today line, the chosen picker row.",
        "section": "colors"
      },
      {
        "name": "The Words First Rule",
        "body": "Late, amber and ok never appear as colour alone; the wash sits behind the words, and late and amber carry a leading '!'.",
        "section": "colors"
      },
      {
        "name": "The Tone Not Border Rule",
        "body": "Regions separate by stepping the ladder, not by outlining. Hairlines live inside tables and lists only.",
        "section": "elevation"
      },
      {
        "name": "The Figures Lead Rule",
        "body": "On a partner screen the largest type is a number or a date, never a heading.",
        "section": "typography"
      },
      {
        "name": "The Two Words Rule",
        "body": "A label is one or two words; a sentence must be a fact the UI cannot show otherwise.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do set the figure larger than the title",
      "Do step the ladder for regions and keep hairlines for rows",
      "Do put every status in words with the chip behind them",
      "Do keep one hi-vis control per screen, 56px tall",
      "Do use .btn, .seg, .input, .table, .plate before writing screen CSS",
      "Do keep labels to one or two words"
    ],
    "donts": [
      "Don't use orange for headings, you-are-here, status or decoration",
      "Don't put a white box, a gradient or a resting shadow on the dark ground",
      "Don't add eyebrow labels, uppercase tracking or middle-dot meta strings",
      "Don't hard-code a colour in screen CSS",
      "Don't put a coloured edge thicker than 1px on a row, card or callout",
      "Don't fall back to a system display face"
    ]
  }
