# Copy to .env and fill in. .env is git-ignored. npm test needs none of these.

# Telegram bot (from BotFather) and the one Telegram user allowed to talk to it.
TELEGRAM_BOT_TOKEN=
DOMINIC_TELEGRAM_USER_ID=
# Old name for the same setting. Only read if the DOMINIC_TELEGRAM_USER_ID line above is deleted.
# TELEGRAM_ALLOWED_USER_ID=

# Which model parses messages into operations. One line to switch: the model
# name picks the provider (gpt-* / o* -> OpenAI, gemini-* -> Google, claude-* ->
# Anthropic). Candidates: gpt-5-mini, gemini-2.5-flash, claude-haiku-4-5.
# Fill in the API key for the provider you pick below.
LLM_MODEL=gpt-5-mini
# Only needed when LLM_MODEL is blank or not one of those families:
# LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Another name for GEMINI_API_KEY. Used only when GEMINI_API_KEY is blank.
# GOOGLE_API_KEY=

# Optional model tuning. Leave these commented out unless you need them.
# Another address for the provider's API (an OpenAI-, Gemini- or Anthropic-compatible server).
# LLM_BASE_URL=
# Longest reply the model may write, in tokens (default 4096; 1024 for claude-*).
# LLM_MAX_TOKENS=
# How long to wait for the model before giving up, in milliseconds (default 30000).
# LLM_TIMEOUT_MS=
# gpt-* only: how hard the model thinks (minimal, low, medium or high). Blank = OpenAI's default.
# LLM_REASONING_EFFORT=
# gemini-* only: how many tokens the model may spend thinking (0 = off). Blank = Google's default.
# LLM_THINKING_BUDGET=

# Voice notes: local whisper.cpp ("local") or OpenAI's transcription API ("cloud").
# Leave TRANSCRIBER blank to use local only when WHISPER_MODEL_PATH is set; otherwise voice is off.
TRANSCRIBER=local
# Path to whisper.cpp's CLI (Homebrew: whisper-cli). Blank = "whisper-cli" on PATH.
WHISPER_CPP_BIN=
# Path to a ggml model file, e.g. ./models/ggml-base.en.bin (models/ is git-ignored)
WHISPER_MODEL_PATH=
# CPU threads for whisper.cpp (blank = its default).
WHISPER_THREADS=
# ffmpeg converts Telegram's OGG voice notes to WAV. Blank = "ffmpeg" on PATH.
FFMPEG_BIN=
# Cloud transcription model (uses OPENAI_API_KEY above unless TRANSCRIBE_API_KEY is set).
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional: a separate key, or another OpenAI-compatible endpoint, for transcription only.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
# Optional: a local Telegram Bot API server instead of https://api.telegram.org.
TELEGRAM_API_ROOT=

# Where the SQLite file and the photos folder live. Relative paths resolve from
# the folder you run npm start in. Default: ./data
DATA_DIR=./data
# What a NEW database starts with: demo (default: the made-up jobs) or empty (sides,
# the duplex template and the trades; no jobs). Going live: npm run seed -- --reset --empty
SEED=
PORT=8787

# Optional: pretend today is this date (YYYY-MM-DD, Australia/Sydney) for demos
# and tests, e.g. 2026-09-17 for the seed's numbers. Leave empty for the real date.
CT_TODAY=
# Old name for CT_TODAY. Only read when CT_TODAY is blank.
# TZ_TODAY_OVERRIDE=

# Server
# Address the API listens on. Keep 127.0.0.1 unless you know you need otherwise.
HOST=127.0.0.1
# Extra host names allowed to call /api (comma-separated), e.g. a Tailscale name.
ALLOWED_HOSTS=
# Sydney time the daily reminders go out (HH:MM).
REMINDER_TIME=07:00
# Folder of the built web app the server serves (default packages/web/dist).
WEB_DIST=

# Read a settings file other than ./.env. Set this in the shell, not in this file,
# e.g. ENV_FILE=/etc/construction-tracker.env npm start
# ENV_FILE=

# Eval only (npm run eval; see packages/eval/README.md).
# Which models to try, comma-separated. Blank = gpt-5-mini, gemini-2.5-flash, claude-haiku-4-5.
# EVAL_MODELS=
# How many test cases run at once (default 4).
# EVAL_CONCURRENCY=
# Time limit for each test case, in milliseconds (default 90000).
# EVAL_TIMEOUT_MS=
