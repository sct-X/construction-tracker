{
  "name": "@ct/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot (grammY, long polling): allowlist, LLM parsing into core operations, questions, confirm cards with dry-run impact, Edit/Cancel, /undo, read-only answers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ct/core": "0.0.0",
    "@ct/llm": "0.0.0",
    "grammy": "^1.46.0"
  }
}
