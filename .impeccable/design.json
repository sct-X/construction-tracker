  "narrative": {
    "northStar": "If Apple made it",
    "overview": "The Human Interface Guidelines translated to the web: iOS grouped surfaces, the system face in Apple's text styles, translucent bars with hairline edges, one orange tint used sparingly and red only for overdue. Calm on purpose, so an overdue item is the first thing the eye finds.",
    "keyCharacteristics": [
      "iOS grouped surfaces: grey ground, white cells; true black in dark",
      "The system face, no web font",
      "One tint, the Cruise orange deepened for AA",
      "Red is overdue only; no amber",
      "Translucent nav bar and tab bar; a macOS source list on the desktop",
      "44px targets, 56px for the site role"
    ],
    "rules": [
      {
        "name": "The Tint Rule",
        "body": "Orange means you can act here or you are here: the filled button, plain buttons, the selected tab, the current sidebar glyph, focus. One filled button per screen.",
        "section": "colors"
      },
      {
        "name": "The Red Rule",
        "body": "Red is overdue. If it isn't past its date, it isn't red.",
        "section": "colors"
      },
      {
        "name": "The Words First Rule",
        "body": "Colour agrees with words, never replaces them; warnings carry a leading '!'.",
        "section": "colors"
      },
      {
        "name": "The On-Fill Rule",
        "body": "Text on the steel or tint fill is white from a token, never the label ladder.",
        "section": "colors"
      },
      {
        "name": "The Two Words Rule",
        "body": "A label is one or two words; a sentence must be a fact the UI cannot show otherwise.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Group headers and labels are sentence-case footnotes, never uppercase or tracked.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do start from .btn, .seg, .input, .group/.cell, .table, .plate",
      "Do put content in white cells on the grouped ground",
      "Do keep one filled tint button per screen",
      "Do pair every status colour with words; keep red for overdue",
      "Do give every date its relative time",
      "Do keep targets at 44px, 56px for the site role"
    ],
    "donts": [
      "Don't load a web font",
      "Don't use amber, a second accent, a gradient or a resting shadow",
      "Don't use orange for headings, status or decoration",
      "Don't add eyebrow labels or uppercase tracking",
      "Don't hard-code a colour in screen CSS",
      "Don't add bounce or section entrance animations"
    ]
  }
