# Copy to .env and fill in. .env is git-ignored. npm test needs none of these.

# Telegram bot (from BotFather) and the one Telegram user allowed to talk to it.
TELEGRAM_BOT_TOKEN=
DOMINIC_TELEGRAM_USER_ID=

# Which model parses messages into operations. One line to switch: the model
# name picks the provider (gpt-* / o* -> OpenAI, gemini-* -> Google, claude-* ->
# Anthropic). Candidates: gpt-5-mini, gemini-2.5-flash, claude-haiku-4-5.
# Fill in the API key for the provider you pick below.
LLM_MODEL=gpt-5-mini
# Only needed when LLM_MODEL is blank or not one of those families:
# LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Voice notes: local whisper.cpp ("local") or OpenAI's transcription API ("cloud").
# Leave TRANSCRIBER blank to use local only when WHISPER_MODEL_PATH is set; otherwise voice is off.
TRANSCRIBER=local
# Path to whisper.cpp's CLI (Homebrew: whisper-cli). Blank = "whisper-cli" on PATH.
WHISPER_CPP_BIN=
# Path to a ggml model file, e.g. ./models/ggml-base.en.bin
WHISPER_MODEL_PATH=
# CPU threads for whisper.cpp (blank = its default).
WHISPER_THREADS=
# ffmpeg converts Telegram's OGG voice notes to WAV. Blank = "ffmpeg" on PATH.
FFMPEG_BIN=
# Cloud transcription model (uses OPENAI_API_KEY above unless TRANSCRIBE_API_KEY is set).
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional: a separate key, or another OpenAI-compatible endpoint, for transcription only.
TRANSCRIBE_API_KEY=
TRANSCRIBE_BASE_URL=
# Optional: a local Telegram Bot API server instead of https://api.telegram.org.
TELEGRAM_API_ROOT=

# Where the SQLite file and the photos folder live. Relative paths resolve from
# the folder you run npm start in. Default: ./data
DATA_DIR=./data
PORT=8787

# Optional: pretend today is this date (YYYY-MM-DD, Australia/Sydney). Leave
# empty to use the real date.
# Pin "today is" (YYYY-MM-DD) for demos and tests; leave empty for the real date.
CT_TODAY=

# Server
# Address the API listens on. Keep 127.0.0.1 unless you know you need otherwise.
HOST=127.0.0.1
# Extra host names allowed to call /api (comma-separated), e.g. a Tailscale name.
ALLOWED_HOSTS=
# Sydney time the daily reminders go out (HH:MM).
REMINDER_TIME=07:00
# Folder of the built web app the server serves (default packages/web/dist).
WEB_DIST=
